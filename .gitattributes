# Finales de línea uniformes (evita que Windows marque todos los archivos como modificados)
* text=auto eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Binarios
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.svg  text eol=lf
*.mp4  binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
